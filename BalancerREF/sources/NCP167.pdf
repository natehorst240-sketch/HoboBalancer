         <dc:format>application/pdf</dc:format>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">NCP167 - Low Regulator - Ultra-Low Noise, High PSRR, RF and Analog Circuits</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:creator>
            <rdf:Seq>
               <rdf:li>onsemi</rdf:li>
            </rdf:Seq>
         </dc:creator>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">The NCP167 is a linear regulator capable of supplying 700 mA output current. Designed to meet the requirements of RF and analog circuits, the NCP167 device provides low noise, high PSRR, low quiescent current, and very good load/line transients.</rdf:li>
            </rdf:Alt>
         </dc:description>
         <pdf:Producer>Acrobat Distiller 23.0 (Windows)</pdf:Producer>
